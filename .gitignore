# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Obsidian：窗口布局、图谱、快捷键、第三方插件本体都不入库；
# 但语义配色 snippet 及其启用状态是这套笔记系统的一部分（见 语义颜色使用规范.md），必须入库，
# 否则换机器 clone 下来 <span class="note-red"> 会静默变成普通黑字。
.obsidian/*
!.obsidian/snippets/
!.obsidian/appearance.json

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# JavaScript / TypeScript
node_modules/
.npm/
.pnpm-store/
.yarn/
dist/
coverage/
.next/
.nuxt/
.vite/

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Java / JVM
.gradle/
target/
*.class

# Build and tooling caches
.cache/
.parcel-cache/
*.tsbuildinfo

# 嵌套 git worktree：工作区里出现嵌套仓库时，git add 不会递归进去，
# 只会记一条 gitlink。没有 .gitmodules 就是「幽灵子模块」——
# GitHub 上渲染成死链，git status 会因为找不到它的 gitdir 而报错。
*.worktrees/

# 课程仓库的本地克隆（2026-10-06 clone，来自 GMyhf/2026fall-cs101）。
# 它自带 .git，若被 git add 会以 gitlink 形式记进这份索引仓库（同上「幽灵子模块」问题），
# 而它真正的更新靠 `git pull upstream main`，不靠这里。操作说明见 2026fall-cs101-使用说明.md
2026fall-cs101yan/

